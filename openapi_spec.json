{
  "openapi": "3.1.0",
  "info": {
    "title": "Fda Faers Signal Disproportionality API",
    "description": "Exploratory FAERS-style 2x2 reporting disproportionality and retained legacy telemetry endpoints; no causality inference.",
    "version": "2.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counters for legacy runtime status (not Prometheus format)",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Run retained legacy telemetry threshold evaluation (not FAERS PRR/ROR)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Run deterministic mock supervisor chat (no external LLM)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve authenticated legacy audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        },
        "security": [
          {
            "AuditViewBearer": []
          }
        ]
      }
    },
    "/api/signal": {
      "post": {
        "summary": "Compute PRR, ROR, Yates chi-square and crude observed/expected IC",
        "description": "Hypothesis-generating case-reporting associations; crude IC is not Bayesian BCPNN.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "a",
                  "b",
                  "c",
                  "d"
                ],
                "properties": {
                  "a": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "b": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "c": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "d": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "continuity_correction": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Descriptive statistics, intervals and screening flag"
          },
          "422": {
            "description": "Invalid counts"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AuditViewBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token supplied by AUDIT_VIEW_TOKEN; logging must be explicitly configured."
      }
    }
  }
}
